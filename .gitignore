.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.mobileprovision

# İmzalama anahtarları — release keystore ASLA git'e girmez.
# Kaybolursa Play Store'da aynı uygulamayı bir daha güncelleyemezsin;
# git'e girerse anahtarı ele geçiren senin adına imzalı APK üretebilir.
*.keystore
*.jks
*.p12
*.p8
*.key

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
